# Copy this file to .env. Use real NIST files outside this repository.
REST_URL=http://127.0.0.1:18127/api/v1/nist
# Set only if your installed receiver requires a token (copy from the app).
REST_TOKEN=
REQUEST_TIMEOUT_MS=60000

KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC=herta.nist
KAFKA_FORMAT=json-base64
KAFKA_CLIENT_ID=herta-external-publisher
KAFKA_TLS=false
# Optional trusted CA file for a TLS broker. Certificate verification stays on.
KAFKA_CA_FILE=
# Leave empty for no SASL: plain | scram-sha-256 | scram-sha-512
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=
# Conservative payload budget; broker/topic/consumer limits must also allow it.
KAFKA_MAX_MESSAGE_BYTES=900000

# REST pull source example: change to 0.0.0.0 for Docker worker access.
SOURCE_HOST=127.0.0.1
SOURCE_PORT=18200
