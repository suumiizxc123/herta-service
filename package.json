{
  "name": "herta-operations-desktop",
  "version": "1.9.18",
  "description": "Desktop interface for HERTA BioCom subject and NIST file operations",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "vite build && electron .",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:renderer": "vite build",
    "test": "node --test",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win nsis portable",
    "dist:mac": "vite build && electron-builder --mac dmg",
    "dist:linux": "vite build && electron-builder --linux AppImage"
  },
  "devDependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.sumiya.hertaoperations",
    "productName": "HERTA Operations",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "platform",
        "to": "platform"
      },
      {
        "from": "electron/source-files.js",
        "to": "electron/source-files.js"
      },
      {
        "from": "electron/backup-archive.js",
        "to": "electron/backup-archive.js"
      },
      {
        "from": "electron/cron.js",
        "to": "electron/cron.js"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "icon": "build/icon.png"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "kafkajs": "^2.2.4"
  }
}
